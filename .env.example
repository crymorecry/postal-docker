# =============================================================================
# postal-docker environment configuration
# =============================================================================
# Local Docker Compose: copy to .env and fill in values.
# Coolify: set only the "Required in Coolify" vars below — DB passwords and
# SECRET_KEY are auto-generated via SERVICE_* magic variables in compose.
# =============================================================================

POSTAL_VERSION=3.3.7

# --- Required in Coolify (Environment Variables tab) -------------------------
POSTAL_HOSTNAME=example.com
POSTAL_WEB_HOST=postal.example.com
# POSTAL_SMTP_HOST defaults to POSTAL_WEB_HOST if unset
# POSTAL_WEB_HOST can be omitted if you assign a domain to postal-web in Coolify
# (SERVICE_FQDN_POSTAL-WEB is used automatically by init.sh)

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User
INITIAL_ADMIN_PASSWORD=change-me-strong-admin-password

# --- Auto-generated on Coolify (do not set unless overriding) ----------------
# SERVICE_PASSWORD_MARIADB_ROOT  -> MariaDB root password
# SERVICE_PASSWORD_MARIADB       -> MariaDB postal user password
# SERVICE_BASE64_64_SECRET       -> Rails SECRET_KEY

# --- Local-only overrides (Coolify uses compose defaults) --------------------
RAILS_ENV=production
DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_NAME=postal
DATABASE_USER=postal
# For local docker compose without Coolify magic vars:
DATABASE_PASSWORD=change-me-strong-database-password
DATABASE_ROOT_PASSWORD=change-me-strong-root-password
SECRET_KEY=change-me-generate-with-openssl-rand-hex-64

# --- DNS (optional — sensible defaults derived from POSTAL_HOSTNAME) ---------
DNS_MX=mx1.example.com,mx2.example.com
DNS_SPF=spf.example.com
DNS_DKIM_SELECTOR=postal
DNS_RETURN_PATH=rp.example.com

LOG_LEVEL=info
WAIT_FOR_TIMEOUT=120

# RabbitMQ is NOT required (removed in Postal v3). See README.md.
