# =============================================================================
# postal-docker environment configuration
# Copy this file to .env and fill in all values before deploying.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Postal image
# Pin to a specific release in production. See https://github.com/postalserver/postal/releases
# -----------------------------------------------------------------------------
POSTAL_VERSION=3.3.7

# -----------------------------------------------------------------------------
# Hostnames
# POSTAL_HOSTNAME: base domain for your Postal installation (e.g. example.com)
# POSTAL_WEB_HOST: hostname for the web UI (e.g. postal.example.com)
# POSTAL_SMTP_HOST: hostname for the SMTP server (e.g. postal.example.com)
# -----------------------------------------------------------------------------
POSTAL_HOSTNAME=example.com
POSTAL_WEB_HOST=postal.example.com
POSTAL_SMTP_HOST=postal.example.com

# -----------------------------------------------------------------------------
# Rails / application secrets
# Generate SECRET_KEY with: openssl rand -hex 64
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-generate-with-openssl-rand-hex-64
RAILS_ENV=production

# -----------------------------------------------------------------------------
# MariaDB
# DATABASE_HOST must match the docker-compose service name (mariadb).
# DATABASE_ROOT_PASSWORD is used only by the MariaDB container on first init.
# -----------------------------------------------------------------------------
DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_NAME=postal
DATABASE_USER=postal
DATABASE_PASSWORD=change-me-strong-database-password
DATABASE_ROOT_PASSWORD=change-me-strong-root-password

# -----------------------------------------------------------------------------
# DNS records (used in postal.yml for domain verification guidance)
# DNS_MX: comma-separated list of MX hostnames (e.g. mx1.example.com,mx2.example.com)
# DNS_SPF: hostname for SPF include (e.g. spf.example.com)
# DNS_DKIM_SELECTOR: DKIM selector identifier (default: postal)
# DNS_RETURN_PATH: return-path domain (e.g. rp.example.com)
# -----------------------------------------------------------------------------
DNS_MX=mx1.example.com,mx2.example.com
DNS_SPF=spf.example.com
DNS_DKIM_SELECTOR=postal
DNS_RETURN_PATH=rp.example.com

# -----------------------------------------------------------------------------
# Logging
# Postal logs to STDOUT when logging.enabled is true (recommended for containers).
# LOG_LEVEL: debug, info, warn, error (maps to Rails log level)
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Initial admin user (created automatically on first deploy if set)
# Leave blank to skip automatic admin creation and run manually:
#   docker compose run --rm postal-web postal make-user
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User
INITIAL_ADMIN_PASSWORD=change-me-strong-admin-password

# -----------------------------------------------------------------------------
# RabbitMQ — NOT REQUIRED
# Postal v3+ removed the RabbitMQ dependency. Do not add a RabbitMQ service.
# See README.md for details.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Optional: init container tuning
# -----------------------------------------------------------------------------
WAIT_FOR_TIMEOUT=120
